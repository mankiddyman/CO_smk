            --chrom_map {input.chrom_map} \
            --out_dir {params.out_dir} \
            --bin_mb {params.bin_mb} \
            --coc_interval_mb {params.coc_interval_mb} \
            --n_boot {params.n_boot} \
            > {log} 2>&1
        """



rule composite_landscape:
    """Composite figure: chromosome ideograms + CO landscape + gene/SNP/satellite/LTR
    density tracks + SyRI synteny ribbons (hap1<->hap2). karyoploteR-based."""
    input:
        co_intervals = "results/crossovers/{sample}/co_intervals.bed",
        co_per_cell  = "results/crossovers/{sample}/co_per_cell.tsv",
        chrom_map    = "results/cell_data/{sample}/chrom_map.tsv",
        markers_vcf  = "results/markers/{sample}/markers.vcf.gz",
        samples_csv  = "config/samples.csv",
        # All annotation paths come from samples.csv via the script.
        # We list them as inputs for cache invalidation:
        genes_gff    = lambda w: samples.loc[w.sample, "annotation_gff"],
        ltr_gff      = lambda w: samples.loc[w.sample, "repeats_ltr_gff"],
        sat_gff      = lambda w: samples.loc[w.sample, "repeats_satellite_gff"],
        syri_out     = lambda w: f"{samples.loc[w.sample, 'syri_dir']}/syri.out",
        syri_mapids  = lambda w: f"{samples.loc[w.sample, 'syri_dir']}/mapids.txt",
        hap2_fai     = lambda w: f"{os.path.dirname(samples.loc[w.sample, 'assembly_fasta'])}/hap2.fasta.fai",
    output:
        pdf = "results/composite/{sample}/composite.pdf",
    log: "logs/composite_landscape/{sample}.log"
    threads: 2
    resources:
        mem_mb = 8000,
        runtime = 30,
    conda: "envs/karyoploter.yaml"
    params:
        win_mb = config.get("composite", {}).get("win_mb", 5),
        step_mb = config.get("composite", {}).get("step_mb", 0.5),
    shell:
        """
        Rscript workflow/scripts/composite_landscape.R \
            --sample_id {wildcards.sample} \
            --samples_csv {input.samples_csv} \
            --co_intervals {input.co_intervals} \
            --co_per_cell {input.co_per_cell} \
            --chrom_map {input.chrom_map} \
            --markers_vcf {input.markers_vcf} \
            --hap2_fai {input.hap2_fai} \
            --out_pdf {output.pdf} \
            --win_mb {params.win_mb} \
            --step_mb {params.step_mb} \
            > {log} 2>&1
        """



# ---------------------------------------------------------------- haplotype alignment
import os


def hap_source(w):
    """Dual-haplotype assembly the published hap1 reference was cut from.

    Read from the reference's MANIFEST.txt (source_fasta), so hap2 always
    comes from the same assembly as the hap1 the markers are called on.
    """
    ref_dir = os.path.dirname(samples.loc[w.sample, "assembly_fasta"])
    with open(os.path.join(ref_dir, "MANIFEST.txt")) as fh:
        for line in fh:
            if line.startswith("source_fasta:"):
                return line.split(":", 1)[1].strip()
    raise ValueError(f"{ref_dir}/MANIFEST.txt has no source_fasta line")


def hap2_chroms(w):
    """hap2 sequence names, one per hap1 chromosome (chrN_hap1 -> chrN_hap2),
    read from the reference .fai. hap_align checks afterwards that they cover
    every sequence in hap2.fa, so a hap2-only scaffold cannot slip through."""
    fai = samples.loc[w.sample, "assembly_fasta"] + ".fai"
    with open(fai) as fh:
        names = [l.split("\t", 1)[0] for l in fh if l.strip()]
    bad = [n for n in names if not n.endswith("_hap1")]
    if bad:
        raise ValueError(f"{fai}: sequence names without the _hap1 suffix: {bad[:3]}")
    return [n[: -len("_hap1")] + "_hap2" for n in names]


rule hap2_extract:
    """hap2's sequences, cut from the dual assembly the reference MANIFEST names."""
    input:
        dual = hap_source,
    output:
        hap2 = "results/hap_align/{sample}/hap2.fa",
    log:
        "logs/hap_align/{sample}.hap2_extract.log",
    shell:
        r"""
        awk '/^>/ {{keep = ($1 ~ /_hap2$/)}} keep' {input.dual} > {output.hap2} 2> {log}
        echo "hap2 sequences: $(grep -c '^>' {output.hap2})" >> {log}
        test -s {output.hap2}
        """


rule hap_align_chrom:
    """One whole hap2 chromosome aligned onto all of hap1 (minimap2 asm20, base-level).

    minimap2 maps each query sequence independently: the same index and
    settings give the same alignments whether it is handed one chromosome or
    all of them (verified: byte-identical PAF on simulated haplotypes with
    repeats, an inversion and a translocation). One job per chromosome
    therefore reproduces a whole-genome run exactly and only bounds memory to
    one chromosome -- all six of paradoxa's in flight at once failed to
    allocate in 160 GB. Wall time is set by the longest chromosome, which one
    thread aligns on its own.
    The preset is per species (config hap_align): it decides sensitivity and,
    for long chromosomes, whether minimap2's 32-bit chaining limit is reached
    at all. --cs for paftools call, --eqx for SyRI.
    """
    input:
        approved("hap_align"),
        hap1 = lambda w: samples.loc[w.sample, "assembly_fasta"],
        hap2 = "results/hap_align/{sample}/hap2.fa",
    output:
        paf = "results/hap_align/{sample}/by_chrom/{chrom}.paf",
    log:
        "logs/hap_align/{sample}.{chrom}.log",
    benchmark:
        "benchmarks/hap_align/{sample}.{chrom}.tsv",
    threads: 2
    params:
        preset = lambda w: param_for(w.sample, "hap_align", "preset"),
    resources:
        mem_mb = lambda w: resource_for(w.sample, "hap_align", "align_mem_mb"),
        runtime = lambda w: resource_for(w.sample, "hap_align", "align_runtime"),
    conda:
        "envs/hap_align.yaml"
    shell:
        r"""
        trap 'rm -f {output.paf}.query.fa' EXIT
        awk -v c={wildcards.chrom} '/^>/ {{keep = (substr($1, 2) == c)}} keep' {input.hap2} > {output.paf}.query.fa
        test -s {output.paf}.query.fa
        minimap2 -x {params.preset} -c --eqx --cs -t {threads} -I8G {input.hap1} {output.paf}.query.fa > {output.paf} 2> {log}
        """


rule hap_align:
    """All of hap2 on hap1: the per-chromosome PAFs concatenated in hap1 order,
    after checking they cover every sequence in hap2.fa. Feeds the marker
    audit (assembly SNPs, alignable regions) and SyRI. Nothing in the
    crossover chain reads it, so it can never trigger a rerun."""
    input:
        hap2 = "results/hap_align/{sample}/hap2.fa",
        pafs = lambda w: expand("results/hap_align/{sample}/by_chrom/{chrom}.paf",
                                sample=w.sample, chrom=hap2_chroms(w)),
    output:
        paf = "results/hap_align/{sample}/hap2_on_hap1.paf",
    log:
        "logs/hap_align/{sample}.log",
    params:
        expected = lambda w: " ".join(sorted(hap2_chroms(w))),
    shell:
        r"""
        have=$(grep '^>' {input.hap2} | cut -c2- | awk '{{print $1}}' | LC_ALL=C sort | tr '\n' ' ' | sed 's/ $//')
        if [ "$have" != "{params.expected}" ]; then
            echo "hap2.fa holds [$have], expected [{params.expected}]" > {log}
            exit 1
        fi
        cat {input.pafs} > {output.paf}
        echo "concatenated $(echo {input.pafs} | wc -w) chromosome PAFs" > {log}
        """
