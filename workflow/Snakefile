rule qc_report:
    """Concatenate the three stages into one summary and flag list."""
    input:
        s1 = "qc/{sample}/01_markers/summary.tsv",
        s2 = "qc/{sample}/02_cells/summary.tsv",
        s3 = "qc/{sample}/03_cos/summary.tsv",
        f1 = "qc/{sample}/01_markers/flags.txt",
        f2 = "qc/{sample}/02_cells/flags.txt",
        f3 = "qc/{sample}/03_cos/flags.txt",
    output:
        summary = "qc/{sample}/summary.tsv",
        flags   = "qc/{sample}/flags.txt",
    shell:
        """
        head -1 {input.s1} > {output.summary}
        for f in {input.s1} {input.s2} {input.s3}; do tail -n +2 "$f" >> {output.summary}; done
        : > {output.flags}
        for f in {input.f1} {input.f2} {input.f3}; do grep -v '^#' "$f" >> {output.flags} || true; done
        n=$(grep -c . {output.flags} || true)
        echo "qc_report: {wildcards.sample} -- $n flags" >&2
        """


rule cell_snp_counting:
    """Per-cell allele counts at marker positions using cellsnp-lite."""
    input:
        approved("cell_snp"),
        bam = "results/starsolo/{sample}/Aligned.uniq.bam",
        bai = "results/starsolo/{sample}/Aligned.uniq.bam.bai",
