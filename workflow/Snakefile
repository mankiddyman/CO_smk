# workflow/Snakefile
import pandas as pd
import os
configfile: "config/config.yaml"

samples = pd.read_csv("config/samples.csv").set_index("sample_id", drop=False)

# Samples excluded from `rule all` end-to-end pipeline.
# Drosera samples currently QC-only: we want starsolo mapping rate
# but not downstream CO calling (no hifi reads yet, no marker reference).
DROSERA_QC_ONLY = ["Dbinata_10x", "Dparadoxa_10x"]

SAMPLES = [s for s in samples.index.tolist()
           if s != "6303_B_hap2"
           and s not in DROSERA_QC_ONLY]
marker_samples = samples[samples["is_marker_reference"] == "yes"].index.tolist()

def param_for(sample_id, section, key):
    """Resolve a per-species parameter. STRICT since 2026-09-21: no fallback.

    config[section][species] must exist, carry a non-empty `_approved` stamp
    ("<date> | <evidence>"), and contain `key`. Anything else is a hard error
    naming what is missing. A missing block or stamp means the stage has not
    been reviewed for that species -- that refusal IS the approval gate.
    `_template` blocks are never read: copy one when adding a species.
    Resources that fail loudly when wrong go through resource_for() instead.
    """
    species = samples.loc[sample_id, "species"]
    sec = config.get(section)
    if not isinstance(sec, dict):
        raise ValueError(f"config has no section {section!r}")
    block = sec.get(species)
    if not isinstance(block, dict):
        raise ValueError(
            f"GATE {section}.{species}: no block. Copy {section}._template, "
            f"decide every value from {species}'s own data, add _approved, "
            f"then rerun.")
    if not str(block.get("_approved", "")).strip():
        raise ValueError(
            f"GATE {section}.{species}: no _approved stamp -- this stage has "
            f"not been reviewed for {species}. Review it, then stamp it.")
    if key not in block:
        raise ValueError(
            f"{section}.{species}.{key} is not set -- no defaults, by design.")
    return block[key]


def resource_for(sample_id, section, key):
    """Memory, runtime and STAR buffers. A wrong value fails LOUDLY -- an OOM,
    a timeout, or a STAR error naming the number it needs -- never as a
    plausible wrong result, so these may fall back to _template. Never route
    anything that changes outputs through here."""
    species = samples.loc[sample_id, "species"]
    sec = config[section]
    block = sec.get(species)
    if isinstance(block, dict) and key in block:
        return block[key]
    return sec["_template"][key]


def approved(*sections):
    """Input function: refuse to build the DAG for a species whose `sections`
    are not stamped. Returns no files, so it never changes mtimes, params
    hashes, or what a job reads. Evaluated when the DAG is built -- dry-runs
    included, and before anything upstream runs -- which param_for() alone is
    not: params are only formatted when a job starts."""
    def _gate(w):
        species = samples.loc[w.sample, "species"]
        for section in sections:
            block = config[section].get(species)
            if not isinstance(block, dict):
                raise ValueError(
                    f"GATE {section}.{species}: no block -- not reviewed for "
                    f"{species}. Copy {section}._template, decide every value "
                    f"from {species}'s own data, add _approved.")
            if not str(block.get("_approved", "")).strip():
                raise ValueError(
                    f"GATE {section}.{species}: no _approved stamp -- not "
                    f"reviewed for {species} yet.")
        return []
    return _gate


# {sample} never contains a slash. Without this, qc_report's
# qc/{sample}/flags.txt also matches qc/X/01_markers/flags.txt -- its own
# inputs -- and DAG building recurses into PeriodicWildcardError.
wildcard_constraints:
    sample = "[^/]+",



rule all:
    input:
        expand("results/starsolo/{sample}/Solo.out/GeneFull/raw/matrix.mtx", sample=SAMPLES),
        expand("results/cells/{sample}/qc_summary.tsv", sample=SAMPLES),
        expand("results/markers/{sample}/markers.tsv", sample=marker_samples),
        expand("results/cells/{sample}/knee_plot.pdf",sample=SAMPLES),
        expand("results/markers/{sample}/diagnostic_histograms.pdf", sample=marker_samples),
        expand("results/snps/{sample}/cellSNP.tag.DP.mtx", sample=SAMPLES),
        expand("results/cell_qc/{sample}/good_cells.tsv", sample=SAMPLES),
        expand("results/cell_qc/{sample}/switch_diagnostics.pdf", sample=SAMPLES),
        expand("results/crossovers/{sample}/.done", sample=SAMPLES),
        expand("results/crossovers/{sample}/co_diagnostics.pdf", sample=SAMPLES),
        expand("results/landscape/{sample}/01_landscape.pdf", sample=SAMPLES),
        expand("results/composite/{sample}/composite.pdf", sample=SAMPLES),
rule gff_to_gtf:
    input:
        gff = lambda w: samples.loc[w.sample, "annotation_gff"],
    output:
        gtf = "results/annotation/{sample}.gtf",
    log: "logs/gff_to_gtf/{sample}.log"
    threads: 1
    resources: mem_mb=4000, runtime=30
    conda: "envs/star.yaml"
    shell:
        r"""
        mkdir -p results/annotation
        gffread {input.gff} -T 2> {log} | \
        awk 'BEGIN{{FS=OFS="\t"}} /^#/ {{print; next}} {{
            match($9, /gene_id "[^"]+";?/); gid = substr($9, RSTART, RLENGTH)
            match($9, /transcript_id "[^"]+";?/); tid = substr($9, RSTART, RLENGTH)
            if (gid !~ /;$/) gid = gid ";"
            if (tid !~ /;$/) tid = tid ";"
            $9 = gid " " tid
            print
        }}' > {output.gtf}
        """


rule star_index:
    input:
        approved("star"),
        fasta = lambda w: samples.loc[w.sample, "assembly_fasta"],
        gtf   = "results/annotation/{sample}.gtf",
    output:
        directory("results/star_index/{sample}"),
        done = "results/star_index/{sample}/.done",
    log: "logs/star_index/{sample}.log"
    benchmark: "benchmarks/star_index/{sample}.tsv"
    threads: 16
    resources:
        mem_mb  = lambda w: resource_for(w.sample, "star", "index_mem_mb"),
        runtime = lambda w: resource_for(w.sample, "star", "index_runtime"),
    conda: "envs/star.yaml"
    params:
        # min(14, log2(genome)/2 - 1). STAR pre-indexes every k-mer prefix of
        # this length, so the table is 4^N: too large wastes memory on a small
        # genome, too small makes STAR scan more suffix-array positions per
        # seed. 13 suits ~0.3-1 Gb; 14 is the ceiling, for >1 Gb.
        sa_nbases = lambda w: param_for(w.sample, "star", "sa_index_nbases"),
        sjdb_overhang = lambda w: param_for(w.sample, "star", "sjdb_overhang"),
        # STAR's OWN cap, distinct from resources.mem_mb (the scheduler ask).
        # STAR defaults to 31 GB internally and dies on large genomes
        # regardless of what Snakemake reserved. Bytes, not MB.
        limit_ram = lambda w: int(resource_for(w.sample, "star", "index_mem_mb")) * 1000000,
    shell:
        """
        mkdir -p {output[0]}
        STAR --runMode genomeGenerate \
             --runThreadN {threads} \
             --genomeDir {output[0]} \
             --genomeFastaFiles {input.fasta} \
             --sjdbGTFfile {input.gtf} \
             --sjdbOverhang {params.sjdb_overhang} \
             --genomeSAindexNbases {params.sa_nbases} \
             --limitGenomeGenerateRAM {params.limit_ram} \
             > {log} 2>&1
        touch {output.done}
        """
def _split_lanes(field):
    """Split a samples.csv cell into a list of lane files on ';' (repo convention)."""
    return [p.strip() for p in str(field).split(";") if p.strip()]

def starsolo_inputs_for(sample_id):
    """Return (cdna_files, barcode_files) as LISTS (one per lane).
    cDNA file chosen by cdna_read (R2/R3); barcode always R1. Lanes ';'-separated,
    cDNA and barcode lists must be in matching lane order.
    Chemistry (UMI len, strand, whitelist) handled in starsolo_params_for."""
    cdna_col = str(samples.loc[sample_id, "cdna_read"]).strip()
    if cdna_col == "R2":
        cdna = _split_lanes(samples.loc[sample_id, "scrna_r2"])
    elif cdna_col == "R3":
        cdna = _split_lanes(samples.loc[sample_id, "scrna_r3"])
    else:
        raise ValueError(f"{sample_id}: cdna_read must be 'R2' or 'R3', got {cdna_col!r}")
    cb = _split_lanes(samples.loc[sample_id, "scrna_r1"])
    if len(cdna) != len(cb):
        raise ValueError(f"{sample_id}: {len(cdna)} cDNA lane(s) vs {len(cb)} barcode lane(s)")
    return cdna, cb

def starsolo_readfiles_arg(sample_id):
    """STAR --readFilesIn argument: 'cdna1,cdna2 cb1,cb2' (cDNA first)."""
    cdna, cb = starsolo_inputs_for(sample_id)
    return ",".join(cdna) + " " + ",".join(cb)


def starsolo_params_for(sample_id):
    """Per-chemistry STARsolo params: UMI length, whitelist, strand."""
    chem = samples.loc[sample_id, "chemistry"]
    if chem == "10x_5p_v1":
        return {"cb_len": 16, "umi_len": 10,
                "whitelist": config["whitelist_5p_v1"],
                "strand": "Reverse"}
    elif chem == "10x_3p_v4":
        # Forward: a 3' kit's cDNA read is sense to the mRNA. This branch said
        # Reverse until 2026-09-23, copied from the 5' branch above, and
        # STARsolo then counts only reads ANTISENSE to their genes. Measured
        # on binata (qc/strandtest, 50 M read pairs counted both ways, and
        # docs/prereview/Dbinata_hap1.cells.txt): 95.3% of reads lie on the
        # same strand as the gene they overlap, piling at 3' ends, and with
        # the 29 rDNA gene models set aside Forward counts 19.2x the UMIs of
        # Reverse (6,239,247 vs 324,563). 10x_5p_v1 keeps Reverse: there the
        # cDNA read is antisense, and Spondias and Cuscuta are unaffected.
        return {"cb_len": 16, "umi_len": 12,
                "whitelist": config["whitelist_3p_v4"],
                "strand": "Forward"}
    else:
        raise ValueError(f"Unknown chemistry for {sample_id}: {chem!r}")


rule starsolo_align:
    input:
        approved("star"),
        index = "results/star_index/{sample}/.done",
        cdna  = lambda w: starsolo_inputs_for(w.sample)[0],
        cb    = lambda w: starsolo_inputs_for(w.sample)[1],
        whitelist = lambda w: starsolo_params_for(w.sample)["whitelist"],
    output:
        matrix = "results/starsolo/{sample}/Solo.out/GeneFull/raw/matrix.mtx",
        bam    = "results/starsolo/{sample}/Aligned.sortedByCoord.out.bam",
        bai    = "results/starsolo/{sample}/Aligned.sortedByCoord.out.bam.bai",
        summary = "results/starsolo/{sample}/Solo.out/Gene/Summary.csv",
        done   = "results/starsolo/{sample}/.done",
    log: "logs/starsolo/{sample}.log"
    benchmark: "benchmarks/starsolo/{sample}.tsv"
    threads: 16
    resources:
        bam_sort_threads = lambda w: resource_for(w.sample, "star", "bam_sort_threads"),
        mem_mb  = lambda w: resource_for(w.sample, "star", "align_mem_mb"),
        runtime = lambda w: resource_for(w.sample, "star", "align_runtime"),
    conda: "envs/star.yaml"
    params:
        index_dir = lambda w: f"results/star_index/{w.sample}",
        out_prefix = lambda w: f"results/starsolo/{w.sample}/",
        readfiles = lambda w: starsolo_readfiles_arg(w.sample),
        cb_len  = lambda w: starsolo_params_for(w.sample)["cb_len"],
        umi_len = lambda w: starsolo_params_for(w.sample)["umi_len"],
        strand  = lambda w: starsolo_params_for(w.sample)["strand"],
        # STAR's default alignIntronMax 0 resolves to
        # (2^winBinNbits)*winAnchorDistNbins = 589,824 bp -- a mammal-scale
        # figure. Capping it is the difference between LOST reads (a junction
        # read that fails to align: costs one marker observation) and MISPLACED
        # reads (a spurious long-gap alignment: puts a wrong allele at a real
        # marker in a real cell, which reads as a haplotype switch and can be
        # called as a crossover). Always prefer lost over misplaced.
        intron_max = lambda w: param_for(w.sample, "star", "align_intron_max"),
        # Bytes. STAR's own BAM-sort buffer, distinct from resources.mem_mb.
        # Hardcoded at 20 GB until 2026-09-21; binata's first alignment died at
        # the sort AFTER finishing mapping and Solo counting (needed 96.5 GB).
        bam_sort_ram = lambda w: resource_for(w.sample, "star", "bam_sort_ram"),
        # Alignments written to the BAM per multimapping read. -1 = STAR's
        # default (all, up to outFilterMultimapNmax 10); 1 = primary only. At
        # binata's 58% multimapping the default writes ~13 B records that
        # filter_bam_uniq and cell_snp_counting both discard at min_mapq 20.
        # Solo counting is unaffected -- this changes BAM content only.
        sam_mult_nmax = lambda w: param_for(w.sample, "star", "sam_mult_nmax"),
    shell:
        """
        mkdir -p {params.out_prefix}
        STAR --runMode alignReads \
             --runThreadN {threads} \
             --genomeDir {params.index_dir} \
             --readFilesIn {params.readfiles} \
             --readFilesCommand zcat \
             --soloType CB_UMI_Simple \
             --soloCBwhitelist {input.whitelist} \
             --soloCBstart 1 --soloCBlen {params.cb_len} \
             --soloUMIstart 17 --soloUMIlen {params.umi_len} \
             --soloFeatures Gene GeneFull \
             --soloStrand {params.strand} \
             --soloUMIfiltering MultiGeneUMI_CR \
             --soloUMIdedup 1MM_CR \
             --soloCBmatchWLtype 1MM_multi_Nbase_pseudocounts \
             --soloCellFilter None \
             --soloBarcodeReadLength 0 \
             --alignIntronMax {params.intron_max} \
             --outSAMmultNmax {params.sam_mult_nmax} \
             --limitBAMsortRAM {params.bam_sort_ram} \
             --outBAMsortingThreadN {resources.bam_sort_threads} \
             --outSAMtype BAM SortedByCoordinate \
             --outSAMattributes NH HI nM AS CR UR CB UB GX GN sS sQ sM \
             --outFileNamePrefix {params.out_prefix} \
             > {log} 2>&1
        samtools index -@ 4 {output.bam} 2>> {log}
        touch {output.done}
        """


