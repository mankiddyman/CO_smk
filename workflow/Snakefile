rule marker_classes:
    """Per-marker behaviour across cells: good / sticky / paralog-like.

    In a pool of haploid meiotic products half the nuclei inherit hap2 at any
    locus, so an informative marker reads ALT in ~50% of cells. 'sticky'
    markers read one allele in nearly every cell and carry no haplotype
    information; 'paralog-like' ones show both alleles inside single cells.
    Measured 2026-09-25 on markers seen in >= 20 cells: binata 46% good /
    38% sticky, paradoxa 56% / 29%. Only 'good' markers feed
    cell_haploidness. Also writes the diagnostic plots. Runs in the
    snakemake env (numpy / pandas / matplotlib)."""
    input:
        dp = "results/snps/{sample}/cellSNP.tag.DP.mtx",
        ad = "results/snps/{sample}/cellSNP.tag.AD.mtx",
        sites = "results/snps/{sample}/cellSNP.base.vcf.gz",
        barcodes = "results/snps/{sample}/cellSNP.samples.tsv",
    output:
        classes = "qc/markers/{sample}/marker_classes.tsv.gz",
    log: "logs/marker_classes/{sample}.log"
    threads: 1
    resources:
        mem_mb = 48000,
        runtime = 120,
    shell:
        """
        mkdir -p "$(dirname {log})"
        python workflow/scripts/marker_segregation.py {wildcards.sample} none \
            qc/markers/{wildcards.sample} > {log} 2>&1
        """


rule cell_haploidness:
    """Does each barcode carry ONE haploid genome?

    On good markers only: calls closer than 150 bp are one molecule (usually
    one read); each chromosome is cut into consecutive runs of 15 molecules;
    haploidness = mean over runs of |2f - 1|, f = the run's ALT share.
    1 = one clean haplotype; ~0.2 = both haplotypes 50:50. For one haploid
    nucleus whose molecules are a share a foreign, E[haploidness] = 1 - a.
    Also writes haploidness.png and example_tracks.png."""
    input:
        classes = "qc/markers/{sample}/marker_classes.tsv.gz",
        dp = "results/snps/{sample}/cellSNP.tag.DP.mtx",
        ad = "results/snps/{sample}/cellSNP.tag.AD.mtx",
        sites = "results/snps/{sample}/cellSNP.base.vcf.gz",
        barcodes = "results/snps/{sample}/cellSNP.samples.tsv",
    output:
        table = "qc/haplotypes/{sample}/haplotype_tracks.tsv.gz",
    log: "logs/cell_haploidness/{sample}.log"
    threads: 1
    resources:
        mem_mb = 48000,
        runtime = 120,
    shell:
        """
        mkdir -p "$(dirname {log})"
        python workflow/scripts/haplotype_tracks.py {wildcards.sample} \
            qc/haplotypes/{wildcards.sample} > {log} 2>&1
        """


def _select_on(w):
    return param_for(w.sample, "cell_qc", "select_on")


def _cellqc_for(mode, key):
    """A cell_qc value, read only for the selection mode that uses it, so a
    species need not carry keys its mode ignores (param_for is strict)."""
    return lambda w: param_for(w.sample, "cell_qc", key) if _select_on(w) == mode else ""


rule select_cells:
    """Choose the cells crossovers are called in; mode per species
    (cell_qc.<species>.select_on):

    switch_rate  the original path (Cuscuta, Spondias; pinned): select_cells.R
                 on switch_diagnostics -- min_total_markers,
                 min_per_chrom_markers, max_switch_rate.
    haploidness  (Drosera, 2026-09-25) barcodes whose informative markers
                 follow ONE haplotype: haploidness >= min_haploidness with
                 >= min_windows full windows, from cell_haploidness.

    WHY two modes: in the Drosera libraries ~70-75% of neighbouring marker
    pairs sit on one read and agree automatically, so the all-marker switch
    rate mostly measured read clustering and depth. Pairs on different
    molecules disagree ~40% in the typical barcode -- most barcodes hold
    both haplotypes -- which that rate could not see."""
    input:
        approved("cell_qc"),
        table = lambda w: ("qc/haplotypes/%s/haplotype_tracks.tsv.gz" % w.sample
                           if _select_on(w) == "haploidness"
                           else "results/cell_qc/%s/switches.tsv" % w.sample),
    output:
        good_cells = "results/cell_qc/{sample}/good_cells.tsv",
        summary = "results/cell_qc/{sample}/selection_summary.txt",
    log: "logs/select_cells/{sample}.log"
    threads: 1
    resources:
        mem_mb = 4000,
        runtime = 10,
    conda: "envs/cell_qc.yaml"
    params:
        select_on = _select_on,
        min_total = _cellqc_for("switch_rate", "min_total_markers"),
        min_per_chrom = _cellqc_for("switch_rate", "min_per_chrom_markers"),
        max_sr = _cellqc_for("switch_rate", "max_switch_rate"),
        min_hap = _cellqc_for("haploidness", "min_haploidness"),
        min_win = _cellqc_for("haploidness", "min_windows"),
    shell:
        """
        if [ "{params.select_on}" = "haploidness" ]; then
            Rscript workflow/scripts/select_haploid_cells.R {input.table} \
                {output.good_cells} {output.summary} {params.min_hap} {params.min_win} \
                > {log} 2>&1
        else
            Rscript workflow/scripts/select_cells.R \
                --switches {input.table} \
                --out {output.good_cells} \
                --out_summary {output.summary} \
                --min_total_markers {params.min_total} \
                --min_per_chrom_markers {params.min_per_chrom} \
                --max_switch_rate {params.max_sr} \
                > {log} 2>&1
        fi
        """



rule co_calling:
    """Call crossovers per cell using hapCO_identification.R.
    Runs in parallel across cells via xargs -P {threads}."""
    input:
        approved("co_calling"),
        good_cells = "results/cell_qc/{sample}/good_cells.tsv",
        chrom_map = "results/cell_data/{sample}/chrom_map.tsv",
    output:
        marker_file = "results/crossovers/{sample}/.done",
        params_log = "results/crossovers/{sample}/co_calling_params.txt",
    log: "logs/co_calling/{sample}.log"
    threads: 8
    resources:
        mem_mb = 16000,
        runtime = 60,
    conda: "envs/cell_qc.yaml"
    params:
        cell_data_dir = lambda w: f"results/cell_data/{w.sample}",
        out_dir = lambda w: f"results/crossovers/{w.sample}/per_cell",
        cell_markers = lambda w: param_for(w.sample, "co_calling", "cell_markers"),
        block_size = lambda w: param_for(w.sample, "co_calling", "block_size"),
        marker_num = lambda w: param_for(w.sample, "co_calling", "marker_num"),
        base_af   = lambda w: param_for(w.sample, "co_calling", "base_af"),
        window_af = lambda w: param_for(w.sample, "co_calling", "window_af"),
        genotype  = lambda w: param_for(w.sample, "co_calling", "genotype"),
        terminal_marker_num = lambda w: param_for(w.sample, "co_calling", "terminal_marker_num"),
    shell:
        r"""
        mkdir -p {params.out_dir}
        rm -f {params.out_dir}/*_co_pred.txt {params.out_dir}/*_co_block_pred.txt {params.out_dir}/*_co.pdf
        # Document parameters used
        cat > {output.params_log} <<EOF
co_calling parameters:
  cell_markers (-c): {params.cell_markers}
  block_size   (-s): {params.block_size}
  marker_num   (-n): {params.marker_num}
  baseAF:            {params.base_af}
  windowAF:          {params.window_af}
  genotype:          {params.genotype}
  terminal_marker_num: {params.terminal_marker_num}
  threads:           {threads}
EOF

        # Run R script per cell, parallelized via xargs
        cat {input.good_cells} | xargs -I {{}} -P {threads} -n 1 \
            bash -c '
                bc="$1"
                Rscript workflow/scripts/hapCO_identification.R \
                    --input {params.cell_data_dir}/${{bc}}.tsv \
                    --prefix "${{bc}}" \
                    --chrom_map {input.chrom_map} \
                    --outpath {params.out_dir} \
                    --cell_markers {params.cell_markers} \
                    --block_size {params.block_size} \
                    --marker_num {params.marker_num} \
                    --baseAF {params.base_af} \
                    --windowAF {params.window_af} \
                    --genotype {params.genotype} \
                    --terminal_marker_num {params.terminal_marker_num} \
                    >> {log} 2>&1
            ' _ {{}}

        touch {output.marker_file}
        echo "co_calling complete: $(wc -l < {input.good_cells}) cells processed" >> {log}
        """


rule co_aggregate:
    """Aggregate per-cell CO calls into landscape summary."""
    input:
        co_done = "results/crossovers/{sample}/.done",
        good_cells = "results/cell_qc/{sample}/good_cells.tsv",
        chrom_map = "results/cell_data/{sample}/chrom_map.tsv",
    output:
        summary = "results/crossovers/{sample}/co_summary.txt",
        bed = "results/crossovers/{sample}/co_intervals.bed",
        per_cell = "results/crossovers/{sample}/co_per_cell.tsv",
        diag = "results/crossovers/{sample}/co_diagnostics.pdf",
    log: "logs/co_aggregate/{sample}.log"
    threads: 1
    resources:
        mem_mb = 8000,
        runtime = 30,
    conda: "envs/cell_qc.yaml"
    params:
        co_dir = lambda w: f"results/crossovers/{w.sample}/per_cell",
        out_dir = lambda w: f"results/crossovers/{w.sample}",
    shell:
        """
        Rscript workflow/scripts/co_aggregate.R \
            --co_dir {params.co_dir} \
            --good_cells {input.good_cells} \
            --chrom_map {input.chrom_map} \
            --out_dir {params.out_dir} \
            > {log} 2>&1
        """

