rule rrna_blacklist:
    """Annotate rRNA loci with barrnap and emit a BED of regions whose markers
    must be excluded.

    Rationale: in poly-A selected scRNA libraries rRNA is not depleted, and
    rRNA is 80-95% of total RNA by mass, so 18S/28S leak in at high abundance.
    Where the assembler has collapsed a 45S tandem array, that leakage lands on
    a few kb of sequence at extreme depth (Spondias_hap1: 13:928-48405, five
    11154 bp units, ~2.3e6x). cellsnp-lite in -R mode issues one pileup fetch
    per marker, so markers inside such an array re-fetch the same enormous read
    stack thousands of times (observed: 10.7 TB read from a 65 GB BAM). Those
    reads are MAPQ 0 anyway (multi-mapping across near-identical units) and are
    dropped by --minMAPQ 20, so excluding the markers loses no usable data.

    Note 5S arrays are annotated too but are harmless: 5S is a ~120 nt Pol III
    transcript, not polyadenylated, and is lost in library size selection
    (Spondias_hap1 chr4 carries 305 5S copies at 0.9x background depth).
    """
    input:
        fasta = lambda w: samples.loc[w.sample, "assembly_fasta"],
    output:
        gff = "results/blacklist/{sample}/rrna.gff",
        bed = "results/blacklist/{sample}/rrna_exclude.bed",
        summary = "results/blacklist/{sample}/rrna_summary.txt",
    log: "logs/rrna_blacklist/{sample}.log"
    threads: 8
    resources:
        mem_mb = 4000,
        runtime = 30,
    conda: "envs/barrnap.yaml"
    params:
        kingdom = config["rrna"]["kingdom"],
        flank = config["rrna"]["flank_bp"],
        merge_gap = config["rrna"]["merge_gap_bp"],
    shell:
        r"""
        barrnap --kingdom {params.kingdom} --threads {threads} \
            {input.fasta} > {output.gff} 2> {log}

        # GFF is 1-based inclusive; BED is 0-based half-open. Flank absorbs
        # reads overhanging the annotated feature. merge_gap closes the
        # intergenic spacers *inside* a tandem array, which are just as deep as
        # the genes themselves - without it the array emerges as N separate
        # intervals with pathological holes between them.
        awk -F'\t' -v f={params.flank} '!/^#/{{
            s = $4 - 1 - f; if (s < 0) s = 0
            print $1"\t"s"\t"$5 + f }}' {output.gff} \
          | sort -k1,1 -k2,2n \
          | bedtools merge -d {params.merge_gap} -i - > {output.bed} 2>> {log}

        {{
          echo "barrnap kingdom={params.kingdom} flank={params.flank} merge_gap={params.merge_gap}"
          echo "rRNA features: $(grep -vc '^#' {output.gff} || true)"
          echo "merged intervals: $(wc -l < {output.bed})"
          echo "excluded bp: $(awk '{{s+=$3-$2}} END{{print s+0}}' {output.bed})"
          echo ""
          echo "features by chrom and product:"
          awk -F'\t' '!/^#/{{split($9,a,";"); sub("Name=","",a[1]); print $1"\t"a[1]}}' {output.gff} \
            | sort | uniq -c
          echo ""
          echo "merged intervals:"
          cat {output.bed}
        }} > {output.summary}
        """


rule filter_markers:
    """Filter raw HiFi VCF to high-confidence heterozygous SNPs."""
    input:
        approved("marker_filters"),
        vcf = "results/markers/{sample}/hifi_raw.vcf.gz",
        rrna_bed = "results/blacklist/{sample}/rrna_exclude.bed",
    output:
        vcf = "results/markers/{sample}/markers.vcf.gz",
        tbi = "results/markers/{sample}/markers.vcf.gz.tbi",
        tsv = "results/markers/{sample}/markers.tsv",
        summary = "results/markers/{sample}/filter_summary.txt",
    log: "logs/filter_markers/{sample}.log"
    threads: 2
    resources:
        mem_mb = 8000,
        runtime = 60,
    conda: "envs/markers.yaml"
    params:
        min_dp = lambda w: param_for(w.sample, "marker_filters", "min_dp"),
        max_dp = lambda w: param_for(w.sample, "marker_filters", "max_dp"),
        min_qual = lambda w: param_for(w.sample, "marker_filters", "min_qual"),
        min_ratio = lambda w: param_for(w.sample, "marker_filters", "min_alt_ratio"),
        max_ratio = lambda w: param_for(w.sample, "marker_filters", "max_alt_ratio"),
    shell:
        r"""
        # Filter: biallelic SNPs, het, DP range, QUAL, allele ratio
        # bcftools expression: INFO and FORMAT fields accessed by name
        bcftools view \
            -m2 -M2 -v snps \
            -g het \
            -e 'QUAL < {params.min_qual} || FMT/DP < {params.min_dp} || FMT/DP > {params.max_dp} || (FMT/AD[0:1] / FMT/DP) < {params.min_ratio} || (FMT/AD[0:1] / FMT/DP) > {params.max_ratio}' \
            -Oz -o {output.vcf} {input.vcf} 2> {log}
        bcftools index -t {output.vcf} 2>> {log}

        # --- Exclude markers inside rRNA arrays (see rule rrna_blacklist) ---
        # Done here, before the TSV export, so markers.tsv and filter_summary.txt
        # both report the post-exclusion set.
        mv {output.vcf} {output.vcf}.prerrna
        bcftools view -T ^{input.rrna_bed} \
            -Oz -o {output.vcf} {output.vcf}.prerrna 2>> {log}
        rm -f {output.vcf}.prerrna {output.vcf}.tbi
        bcftools index -t {output.vcf} 2>> {log}

        # Export to simple TSV: chrom, pos, ref, alt
        bcftools query \
            -f '%CHROM\t%POS\t%REF\t%ALT\n' \
            {output.vcf} > {output.tsv} 2>> {log}

        # Summary
        n_raw=$(bcftools view -H {input.vcf} | wc -l)
        n_filtered=$(wc -l < {output.tsv})
        echo "Raw variants: $n_raw"        > {output.summary}
        echo "Markers after filter: $n_filtered" >> {output.summary}
        echo "Retention: $(echo "scale=4; $n_filtered / $n_raw" | bc)" >> {output.summary}
        echo "" >> {output.summary}
        echo "Per-chromosome marker counts:" >> {output.summary}
        cut -f1 {output.tsv} | sort | uniq -c >> {output.summary}
        echo "" >> {output.summary}
        echo "Filter params: min_dp={params.min_dp}, max_dp={params.max_dp}, min_qual={params.min_qual}, ratio=[{params.min_ratio},{params.max_ratio}]" >> {output.summary}
        """


rule filter_bam_uniq:
    """Pre-filter the STARsolo BAM to reads passing cellsnp's MAPQ threshold.

    WHY: cellsnp-lite applies --minMAPQ AFTER fetching+decompressing each
    pileup. With a collapsed rDNA array (Spondias chr13:1-49152 held 1.25e9
    records, 85% of the BAM, 98% MAPQ 0) every fetch decompressed a mountain
    of reads to keep ~none. Worse, STAR's default ~590kb alignIntronMax makes
    spurious long introns, so htslib returns those reads for markers hundreds
    of kb away -- excluding markers by coordinate does NOT help.

    Applying the identical predicate once up front is output-equivalent (we
    drop only reads cellsnp already discarded) and turns 65GB -> 5.3GB.
    Verified: per-region `view -c -q N` counts identical before/after.

    NOTE: min_mapq here MUST equal cell_snp_counting's --minMAPQ (both read
    config cell_snp.min_mapq) or the prefilter silently removes reads cellsnp
    would have kept."""
    input:
        approved("cell_snp"),
        bam = "results/starsolo/{sample}/Aligned.sortedByCoord.out.bam",
        bai = "results/starsolo/{sample}/Aligned.sortedByCoord.out.bam.bai",
    output:
        bam = "results/starsolo/{sample}/Aligned.uniq.bam",
        bai = "results/starsolo/{sample}/Aligned.uniq.bam.bai",
    log: "logs/filter_bam_uniq/{sample}.log"
    threads: 8
    resources:
        mem_mb = 8000,
        runtime = 120,
    conda: "envs/markers.yaml"
    params:
        min_mapq = lambda w: param_for(w.sample, "cell_snp", "min_mapq"),
    shell:
        """
        mkdir -p "$(dirname {log})"
        samtools view -b -q {params.min_mapq} -@ {threads} \
            -o {output.bam} {input.bam} 2> {log}
        samtools index -@ {threads} {output.bam} 2>> {log}
        echo "records kept: $(samtools view -c -@ 4 {output.bam})" >> {log}
        """


