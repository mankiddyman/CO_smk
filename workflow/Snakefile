        marey        = "results/landscape/{sample}/02_marey_maps.pdf",
        co_classes   = "results/landscape/{sample}/03_co_class_proportions.pdf",
        coc          = "results/landscape/{sample}/04_coc.pdf",
        gamma        = "results/landscape/{sample}/05_gamma_interference.pdf",
        landscape_summary = "results/landscape/{sample}/landscape_summary.tsv",
        coc_table         = "results/landscape/{sample}/coc_table.tsv",
        gamma_summary     = "results/landscape/{sample}/gamma_interference_summary.tsv",
    log: "logs/recombination_landscape/{sample}.log"
    threads: 4
    resources:
        mem_mb = 8000,
        runtime = 30,
    conda: "envs/cell_qc.yaml"
    params:
        out_dir = lambda w: f"results/landscape/{w.sample}",
        bin_mb = config.get("landscape", {}).get("bin_mb", 5),
        coc_interval_mb = config.get("landscape", {}).get("coc_interval_mb", 5),
